    {
      "name": "Prueba de triggers",
      "description": "Ejecutar en este orden. El paso 1 guarda la existencia actual y el paso 5 comprueba que bajo 1.",
      "item": [
        {
          "name": "1. Ver existencia antes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalogo/6/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('existencia_antes', String(pm.response.json().existencia_actual));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Crear venta registrada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ventas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha_venta\": \"2026-10-07\",\n  \"id_tienda\": 6,\n  \"id_empleado\": 22,\n  \"id_cliente\": 224\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('venta creada', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('id_venta', String(body.id_venta));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Stock insuficiente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/detalles-venta",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_venta\": {{id_venta}},\n  \"id_producto\": 1,\n  \"cantidad\": 9999,\n  \"precio_unitario\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rechaza stock', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql('Stock insuficiente');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Venta con stock valido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/detalles-venta",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_venta\": {{id_venta}},\n  \"id_producto\": 1,\n  \"cantidad\": 1,\n  \"precio_unitario\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('detalle creado', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Existencia descontada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalogo/6/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('stock bajo', function () {",
                  "  const antes = Number(pm.collectionVariables.get('existencia_antes'));",
                  "  pm.expect(pm.response.json().existencia_actual).to.eql(antes - 1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Abono parcial",
